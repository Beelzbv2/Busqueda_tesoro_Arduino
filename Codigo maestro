#include <SoftwareSerial.h>

// ==========================================
// DEFINICIÓN DE PINES Y CONSTANTES
// ==========================================
const uint8_t PIN_LED_TIMER  = 9;  // LED Verde PWM
const uint8_t PIN_SOFT_RX    = 10; // Conectar al TX del Esclavo (Pin 11)
const uint8_t PIN_SOFT_TX    = 11; // Conectar al RX del Esclavo (Pin 10)
const uint8_t PIN_UNUSED_ADC = A5; // Pin libre para generar la semilla aleatoria

const unsigned long GAME_DURATION_MS = 60000; // 60 segundos de juego
const unsigned long VICTORY_HOLD_MS   = 2000;  // 2 segundos de permanencia contínua
const unsigned long TX_INTERVAL_MS   = 40;    // Frecuencia de envío serial
const unsigned long TIMEOUT_MS       = 2000;  // Timeout de conexión

// Máquina de Estados del Juego
enum State {
  STATE_INACTIVO,
  STATE_JUGANDO,
  STATE_VICTORIA,
  STATE_DERROTA
};

State currentState = STATE_INACTIVO;

SoftwareSerial linkSerial(PIN_SOFT_RX, PIN_SOFT_TX);

// Posición del Tesoro (2x2) y Lecturas del Jugador
uint8_t tx = 0, ty = 0;
uint8_t posX = 0, posY = 0;
uint8_t levelX = 0, levelY = 0;

// Temporizadores no bloqueantes
unsigned long gameStartTime    = 0;
unsigned long victoryStartTime = 0;
unsigned long lastTxTime       = 0;
unsigned long lastRxTime       = 0;
unsigned long animTimer        = 0;
uint8_t animStep               = 0;
bool linkLost                  = false;

// ==========================================
// CÁLCULO DE DISTANCIAS Y NIVELES
// ==========================================
// Protección contra subflujo de entero si t < 1
uint8_t calculateAxisDistance(uint8_t pos, uint8_t t) {
  if (t < 1) return 100;
  
  uint8_t minCell = t - 1;
  if (pos < minCell) {
    return minCell - pos;
  } else if (pos > t) {
    return pos - t;
  } else {
    return 0; // Posicionado dentro del área del tesoro en este eje
  }
}

uint8_t getProximityLevel(uint8_t d) {
  if (d == 0)  return 3; // AQUÍ (brillo 100%)
  if (d <= 5)  return 2; // CALIENTE (brillo medio)
  if (d <= 10) return 1; // TIBIO (brillo tenue)
  return 0;              // FRÍO (apagado)
}

void startNewGame() {
  randomSeed(analogRead(PIN_UNUSED_ADC));
  tx = random(12, 101); // Coordenada entre 12 y 100 (garantiza FRÍO al iniciar en 0)
  ty = random(12, 101);

  gameStartTime = millis();
  victoryStartTime = 0;
  currentState = STATE_JUGANDO;
}

// ==========================================
// COMUNICACIÓN SERIAL (LECTURA Y RESPUESTA)
// ==========================================
void sendStateAndLevels() {
  uint8_t stateByte = 0xE0;
  if (currentState == STATE_JUGANDO)  stateByte = 0xE1;
  if (currentState == STATE_VICTORIA) stateByte = 0xE2;
  if (currentState == STATE_DERROTA)  stateByte = 0xE3;

  linkSerial.write(stateByte);
  linkSerial.write(0x10 + levelX);
  linkSerial.write(0x20 + levelY);
}

void processIncomingByte(uint8_t b) {
  lastRxTime = millis();
  linkLost = false;

  if (b <= 100) {
    posX = b;
  } else if (b >= 101 && b <= 201) {
    posY = b - 101;
  } else if (b == 0xFE && currentState == STATE_INACTIVO) {
    startNewGame();
  }
}

void readSerialData() {
  while (linkSerial.available() > 0) {
    processIncomingByte(linkSerial.read());
  }
}

// ==========================================
// MÁQUINA DE ESTADOS Y LÓGICA DE JUEGO
// ==========================================
void updateGameLogic() {
  unsigned long now = millis();

  // Verificación del timeout de enlace (> 2000 ms)
  if (now - lastRxTime > TIMEOUT_MS) {
    if (!linkLost) {
      linkLost = true;
      currentState = STATE_INACTIVO; // Abortar partida por desconexión
    }
  }

  if (linkLost) {
    // Parpadeo rápido del LED verde (250 ms)
    bool blink = (now / 250) % 2 == 0;
    analogWrite(PIN_LED_TIMER, blink ? 255 : 0);
    return;
  }

  switch (currentState) {
    case STATE_INACTIVO:
      analogWrite(PIN_LED_TIMER, 0);
      break;

    case STATE_JUGANDO: {
      unsigned long elapsed = now - gameStartTime;

      // Verificación de expiración de tiempo de partida
      if (elapsed >= GAME_DURATION_MS) {
        currentState = STATE_DERROTA;
        animStep = 0;
        animTimer = now;
        break;
      }

      // Atenuación progresiva por PWM del LED Verde (100% a 0%)
      uint8_t timerPwm = ((GAME_DURATION_MS - elapsed) * 255L) / GAME_DURATION_MS;
      analogWrite(PIN_LED_TIMER, timerPwm);

      // Cálculo de distancias y niveles
      uint8_t dx = calculateAxisDistance(posX, tx);
      uint8_t dy = calculateAxisDistance(posY, ty);

      levelX = getProximityLevel(dx);
      levelY = getProximityLevel(dy);

      // Verificación de permanencia contínua durante 2000 ms para ganar
      if (dx == 0 && dy == 0) {
        if (victoryStartTime == 0) {
          victoryStartTime = now;
        } else if (now - victoryStartTime >= VICTORY_HOLD_MS) {
          currentState = STATE_VICTORIA;
          animStep = 0;
          animTimer = now;
        }
      } else {
        victoryStartTime = 0; // Reiniciar temporizador si se sale del área
      }
      break;
    }

    case STATE_VICTORIA:
      // LED Verde encendido al 100% fijo durante la animación
      analogWrite(PIN_LED_TIMER, 255);
      if (now - animTimer >= 250) {
        animTimer = now;
        if (++animStep >= 20) { // Esperar 10 parpadeos del Esclavo
          currentState = STATE_INACTIVO;
        }
      }
      break;

    case STATE_DERROTA:
      // LED Verde parpadea 10 veces (250 ms ON / 250 ms OFF)
      if (now - animTimer >= 250) {
        animTimer = now;
        if (++animStep >= 20) {
          currentState = STATE_INACTIVO;
        }
      }
      analogWrite(PIN_LED_TIMER, (animStep % 2 == 0) ? 255 : 0);
      break;
  }
}

// ==========================================
// SETUP & LOOP PRINCIPAL
// ==========================================
void setup() {
  pinMode(PIN_LED_TIMER, OUTPUT);
  linkSerial.begin(9600);
  lastRxTime = millis();
}

void loop() {
  readSerialData();
  updateGameLogic();

  // Envío periódico de estado y niveles al Esclavo
  unsigned long now = millis();
  if (now - lastTxTime >= TX_INTERVAL_MS) {
    lastTxTime = now;
    sendStateAndLevels();
  }
}
