#include <SoftwareSerial.h>

// ==========================================
// DEFINICIÓN DE PINES Y CONSTANTES
// ==========================================
const uint8_t PIN_POT_X      = A0;
const uint8_t PIN_POT_Y      = A1;
const uint8_t PIN_BTN_START  = 2;  // Conectado con INPUT_PULLUP (a GND)
const uint8_t PIN_LED_X      = 3;  // Salida PWM
const uint8_t PIN_LED_Y      = 5;  // Salida PWM
const uint8_t PIN_SOFT_RX    = 10; // Conectar al TX del Maestro (Pin 11)
const uint8_t PIN_SOFT_TX    = 11; // Conectar al RX del Maestro (Pin 10)

// Niveles PWM referenciales: [0] FRÍO, [1] TIBIO, [2] CALIENTE, [3] AQUÍ
const uint8_t PWM_LEVELS[4]  = {0, 20, 80, 255};
const unsigned long TX_INTERVAL_MS = 40;   // Envío de coordenadas cada 40 ms
const unsigned long TIMEOUT_MS     = 2000; // Timeout por pérdida de enlace
const unsigned long DEBOUNCE_MS    = 40;   // Antirrebote del botón

// Códigos del Protocolo Serial (Maestro -> Esclavo)
const uint8_t CMD_STATE_INACTIVO = 0xE0;
const uint8_t CMD_STATE_JUGANDO  = 0xE1;
const uint8_t CMD_STATE_VICTORIA = 0xE2;
const uint8_t CMD_STATE_DERROTA  = 0xE3;

SoftwareSerial linkSerial(PIN_SOFT_RX, PIN_SOFT_TX);

// ==========================================
// VARIABLES DE ESTADO INTERNO
// ==========================================
uint8_t currentLevelX = 0;
uint8_t currentLevelY = 0;
uint8_t gameState     = CMD_STATE_INACTIVO;

unsigned long lastTxTime    = 0;
unsigned long lastRxTime    = 0;
unsigned long lastDebounce  = 0;
unsigned long animTimer     = 0;

bool lastBtnState   = HIGH;
bool btnState       = HIGH;
bool linkLost       = false;
bool isAnimatingEnd = false;
uint8_t animStep    = 0;

// ==========================================
// LECTURA ADC UNIFORME Y FILTRADO
// ==========================================
uint8_t readADCUniform(uint8_t pin) {
  analogRead(pin); // Lectura de estabilización del multiplexor ADC
  
  uint32_t sum = 0;
  for (uint8_t i = 0; i < 4; i++) {
    sum += analogRead(pin);
  }
  uint32_t avg = sum / 4;
  
  // Conversión matemática uniforme al rango [0, 100]
  uint32_t coord = (avg * 100L) / 1024L;
  return (coord > 100) ? 100 : (uint8_t)coord;
}

// ==========================================
// RECEPCIÓN Y PROTOCOLO BINARIO
// ==========================================
void processIncomingByte(uint8_t b) {
  lastRxTime = millis();
  linkLost = false;

  if (b >= 0x10 && b <= 0x13) {
    currentLevelX = b - 0x10;
  } else if (b >= 0x20 && b <= 0x23) {
    currentLevelY = b - 0x20;
  } else if (b >= 0xE0 && b <= 0xE3) {
    if (gameState != b) {
      gameState = b;
      if (gameState == CMD_STATE_VICTORIA) {
        isAnimatingEnd = true;
        animStep = 0;
        animTimer = millis();
      } else if (gameState == CMD_STATE_DERROTA) {
        isAnimatingEnd = false;
      }
    }
  }
}

void readSerialData() {
  while (linkSerial.available() > 0) {
    processIncomingByte(linkSerial.read());
  }
}

// ==========================================
// BOTÓN DE INICIO CON ANTIRREBOTE
// ==========================================
void checkButton() {
  bool reading = digitalRead(PIN_BTN_START);
  if (reading != lastBtnState) {
    lastDebounce = millis();
  }
  
  if ((millis() - lastDebounce) > DEBOUNCE_MS) {
    if (reading != btnState) {
      btnState = reading;
      // Detección de flanco de bajada (al presionar en INPUT_PULLUP)
      if (btnState == LOW) {
        linkSerial.write((uint8_t)0xFE); // Solicitud de inicio de juego
      }
    }
  }
  lastBtnState = reading;
}

// ==========================================
// CONTROL DE SALIDAS (LEDS Y ANIMACIONES)
// ==========================================
void updateOutputs() {
  unsigned long now = millis();

  // Control de pérdida de enlace (> 2000 ms)
  if (now - lastRxTime > TIMEOUT_MS) {
    linkLost = true;
  }

  if (linkLost) {
    // Parpadeo alternado a 500 ms en LEDs X e Y
    bool alt = ((now / 500) % 2 == 0);
    analogWrite(PIN_LED_X, alt ? 255 : 0);
    analogWrite(PIN_LED_Y, alt ? 0 : 255);
    return;
  }

  // Animación de Victoria (10 parpadeos a 250 ms)
  if (gameState == CMD_STATE_VICTORIA && isAnimatingEnd) {
    if (now - animTimer >= 250) {
      animTimer = now;
      if (++animStep >= 20) isAnimatingEnd = false;
    }
    bool ledOn = (animStep % 2 == 0);
    analogWrite(PIN_LED_X, ledOn ? 255 : 0);
    analogWrite(PIN_LED_Y, ledOn ? 255 : 0);
    return;
  }

  // Comportamiento Normal del Juego
  if (gameState == CMD_STATE_INACTIVO || gameState == CMD_STATE_DERROTA) {
    analogWrite(PIN_LED_X, 0);
    analogWrite(PIN_LED_Y, 0);
  } else if (gameState == CMD_STATE_JUGANDO) {
    analogWrite(PIN_LED_X, PWM_LEVELS[currentLevelX]);
    analogWrite(PIN_LED_Y, PWM_LEVELS[currentLevelY]);
  }
}

// ==========================================
// SETUP & LOOP PRINCIPAL
// ==========================================
void setup() {
  pinMode(PIN_BTN_START, INPUT_PULLUP);
  pinMode(PIN_LED_X, OUTPUT);
  pinMode(PIN_LED_Y, OUTPUT);

  linkSerial.begin(9600);
  lastRxTime = millis();
}

void loop() {
  readSerialData();
  checkButton();

  // Envío periódico de coordenadas X e Y
  unsigned long now = millis();
  if (now - lastTxTime >= TX_INTERVAL_MS) {
    lastTxTime = now;
    linkSerial.write(readADCUniform(PIN_POT_X));        // 0 .. 100
    linkSerial.write(readADCUniform(PIN_POT_Y) + 101);  // 101 .. 201
  }

  updateOutputs();
}
